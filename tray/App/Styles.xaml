<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TelegramMCPTray"
                    xmlns:core="clr-namespace:TelegramMCPTray.Core;assembly=TelegramMCPTray.Core">

    <!-- Colours. Theme.cs replaces these for light/dark and the accent colour; these are the dark defaults. -->
    <SolidColorBrush x:Key="PanelBg" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="PanelBorder" Color="#FF3F3F3F" />
    <SolidColorBrush x:Key="Fg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Fg2" Color="#FFC5C5C5" />
    <SolidColorBrush x:Key="Fg3" Color="#FF8B8B8B" />
    <SolidColorBrush x:Key="Subtle" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Subtle2" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Divider" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Accent" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="Green" Color="#FF2EA043" />
    <SolidColorBrush x:Key="Orange" Color="#FFF7840C" />
    <SolidColorBrush x:Key="Red" Color="#FFE5484D" />
    <SolidColorBrush x:Key="Blue" Color="#FF3B8EEA" />
    <SolidColorBrush x:Key="Gray" Color="#FF8B8B8B" />
    <SolidColorBrush x:Key="Yellow" Color="#FFE3B341" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Windows 11 has Segoe Fluent Icons; Windows 10 has the same code points in Segoe MDL2 Assets. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A capsule button. Filled: solid tint, white text. Not filled: a faint tint, tinted text.
         Choice (a segmented choice): not filled is neutral grey instead. -->
    <Style TargetType="local:PillButton">
        <Setter Property="Tint" Value="{DynamicResource Green}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PillButton">
                    <Grid x:Name="Root" MinHeight="26">
                        <Border x:Name="Bg" CornerRadius="13" Background="{TemplateBinding Tint}" Opacity="0.14" />
                        <ContentPresenter x:Name="Label" Margin="12,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontSize="12" TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{TemplateBinding Tint}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Choice" Value="True" />
                                <Condition Property="Filled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Subtle2}" />
                            <Setter TargetName="Bg" Property="Opacity" Value="1" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Fg2}" />
                        </MultiTrigger>
                        <Trigger Property="Filled" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="1" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The footer buttons: a glyph and a word on a faint rounded background. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="6" Background="{DynamicResource Subtle}" Padding="8,4">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Subtle2}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A button that looks like its content (row headers, back). -->
    <Style x:Key="Flat" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" CornerRadius="6" Background="{DynamicResource Subtle2}" Padding="{TemplateBinding Padding}"
                            BorderThickness="0,0,0,1" BorderBrush="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A thin scroll bar that fits the panel. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Width="5" HorizontalAlignment="Center" Background="{DynamicResource Fg3}" Opacity="0.6" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small coloured tag ("Monitor on", "always allow"...). -->
    <DataTemplate DataType="{x:Type core:Tag}">
        <Grid VerticalAlignment="Center" Margin="4,0,0,0">
            <Border x:Name="Bg" CornerRadius="8" Opacity="0.16" Background="{DynamicResource Gray}" />
            <TextBlock x:Name="Label" Text="{Binding Text}" Margin="7,2" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Gray}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Good">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Green}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Green}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Warn">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Orange}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Orange}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Bad">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Red}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Red}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Info">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Blue}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Blue}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <BooleanToVisibilityConverter x:Key="Visible" />
    <local:BoolToCollapsedConverter x:Key="Hidden" />
    <local:NullToCollapsedConverter x:Key="IfSet" />
</ResourceDictionary>
