<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TelegramMCPTray"
                    xmlns:core="clr-namespace:TelegramMCPTray.Core;assembly=TelegramMCPTray.Core">

    <!-- Colours. Theme.cs replaces these for light/dark (and opaque where there's no acrylic); these are the dark defaults. -->
    <SolidColorBrush x:Key="PanelBg" Color="#FF2E2A28" />
    <SolidColorBrush x:Key="PanelBorder" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Surface" Color="#FF2B2725" />
    <SolidColorBrush x:Key="Fg" Color="#FFF7F5F3" />
    <SolidColorBrush x:Key="Fg2" Color="#FFC9C3BE" />
    <SolidColorBrush x:Key="Fg3" Color="#FF8F8883" />
    <SolidColorBrush x:Key="Card" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="CardHover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Subtle" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Subtle2" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Divider" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Accent" Color="#FFFF6A3D" />
    <SolidColorBrush x:Key="AccentSoft" Color="#2EFF6A3D" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Green" Color="#FF4CC75A" />
    <SolidColorBrush x:Key="Orange" Color="#FFFFAA3B" />
    <SolidColorBrush x:Key="Red" Color="#FFFF5F57" />
    <SolidColorBrush x:Key="Blue" Color="#FF62AEFF" />
    <SolidColorBrush x:Key="Gray" Color="#FF9A938E" />
    <SolidColorBrush x:Key="Yellow" Color="#FFF5D547" />
    <SolidColorBrush x:Key="GreenWash" Color="#263DD68C" />
    <SolidColorBrush x:Key="PendingWash" Color="#26FFB020" />
    <SolidColorBrush x:Key="PendingEdge" Color="#66FFB020" />
    <SolidColorBrush x:Key="YellowWash" Color="#26F5D547" />
    <SolidColorBrush x:Key="RedWash" Color="#26FF5C5C" />
    <SolidColorBrush x:Key="BlueWash" Color="#264FB8F2" />
    <SolidColorBrush x:Key="GrayWash" Color="#269A938E" />
    <SolidColorBrush x:Key="Brand" Color="#FF1B92D1" />
    <!-- Solid fills behind white text: each at least 4.5:1 with white (WCAG AA). -->
    <SolidColorBrush x:Key="AccentFill" Color="#FFE0501F" />
    <SolidColorBrush x:Key="BadgeBg" Color="#FFFFBE4D" />
    <SolidColorBrush x:Key="BadgeFg" Color="#FF1E1A17" />
    <SolidColorBrush x:Key="GreenFill" Color="#FF157A41" />
    <SolidColorBrush x:Key="OrangeFill" Color="#FFA85A00" />
    <SolidColorBrush x:Key="RedFill" Color="#FFC42B2B" />
    <SolidColorBrush x:Key="BlueFill" Color="#FF1565A8" />
    <SolidColorBrush x:Key="GrayFill" Color="#FF6B6560" />

    <!-- The app icon's paper plane (docs/icon.svg), on a 100×100 box. The tray icon draws the same path. -->
    <Geometry x:Key="PlaneGeometry">M88.723,12.142C76.419,17.238,23.661,39.091,9.084,45.047c-9.776,3.815-4.053,7.392-4.053,7.392s8.345,2.861,15.499,5.007c7.153,2.146,10.968-0.238,10.968-0.238l33.62-22.652c11.922-8.107,9.061-1.431,6.199,1.431c-6.199,6.2-16.452,15.975-25.036,23.844c-3.815,3.338-1.908,6.199-0.238,7.63c6.199,5.246,23.129,15.976,24.082,16.691c5.037,3.566,14.945,8.699,16.452-2.146c0,0,5.961-37.435,5.961-37.435c1.908-12.637,3.815-24.321,4.053-27.659C97.307,8.804,88.723,12.142,88.723,12.142z</Geometry>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <!-- Windows 11 has Segoe Fluent Icons; Windows 10 has the same code points in Segoe MDL2 Assets. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A frosted card: everything on the panel sits on one. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- A card's title: "Waiting for approval", with an optional count chip next to it. -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A capsule button. Filled: a solid fill (pass a *Fill brush as Tint, dark enough for white text
         at 4.5:1). Not filled: a faint tint behind tinted text. Choice (a segmented choice): not filled
         is neutral instead. The text colour is set on the button itself, so content written inline
         (an icon and a label) gets it too, not only a plain string. -->
    <Style TargetType="local:PillButton">
        <Setter Property="Tint" Value="{DynamicResource Green}" />
        <Setter Property="Foreground" Value="{Binding Tint, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PillButton">
                    <Grid x:Name="Root" MinHeight="30">
                        <Border x:Name="Bg" CornerRadius="15" Background="{TemplateBinding Tint}" Opacity="0.16" />
                        <Border x:Name="Focus" CornerRadius="15" BorderBrush="{DynamicResource Fg}" BorderThickness="1.5" Opacity="0" />
                        <ContentPresenter Margin="14,5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontSize="12" TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Choice" Value="True" />
                                <Condition Property="Filled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="Transparent" />
                            <Setter TargetName="Bg" Property="Opacity" Value="1" />
                        </MultiTrigger>
                        <Trigger Property="Filled" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Choice" Value="True" />
                    <Condition Property="Filled" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
            </MultiTrigger>
            <Trigger Property="Filled" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A tab in the segmented bar under the header. The open one is a solid deep-orange capsule with
         white text (4.8:1); the others are light text on the glass (Fg2, 6:1+), brighter on hover. -->
    <Style x:Key="Tab" TargetType="local:PillButton">
        <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PillButton">
                    <Border x:Name="Bg" CornerRadius="15" Background="Transparent" MinHeight="30" Padding="6,5"
                            BorderBrush="Transparent" BorderThickness="1.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontSize="12" TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Subtle2}" />
                        </Trigger>
                        <Trigger Property="Filled" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFill}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            </Trigger>
            <Trigger Property="Filled" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A round glass button with a glyph (the header's Rules and Log). -->
    <Style x:Key="RoundButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="14" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CardHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Fg}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A quiet text button with a glyph (the footer). -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="13" Background="Transparent" Padding="10,5">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Subtle2}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Subtle2}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An on/off switch (the listen switches): a track with a knob, blue (white knob, 6:1) when on,
         a faint track with a grey knob when off. Bind IsChecked one-way to the state and give it a
         Command: a click flips it at once and the next poll shows what the daemon saved. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Width="36" Height="20" Background="Transparent">
                        <Border x:Name="Focus" Margin="-3" CornerRadius="13" BorderThickness="1.5" BorderBrush="{DynamicResource Fg}" Opacity="0" />
                        <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource Subtle2}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" />
                        <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource Fg2}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource BlueFill}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BlueFill}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="White" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A button that looks like its content (row headers, a long draft, clear search). It shows a
         focus ring when reached with the keyboard, since it has no other outline. -->
    <Style x:Key="Flat" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Focus" Margin="-4" CornerRadius="12" BorderThickness="1.5" BorderBrush="{DynamicResource Fg}"
                                Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The panel's scrolling middle: the scroll bar floats in the right margin instead of taking
         width from the content, so the cards line up with the header whether it shows or not. -->
    <Style x:Key="OverlayScroll" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Margin="0,0,5,0"
                                   Orientation="Vertical" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                   Value="{TemplateBinding VerticalOffset}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" CornerRadius="15" Background="{DynamicResource Subtle2}" Padding="{TemplateBinding Padding}"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A drop-down (the away time pickers): a capsule like the text boxes, with a chevron, opening a
         list on the panel's surface. The chosen item is tinted with the accent. -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MaxDropDownHeight" Value="232" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg" CornerRadius="15" Background="{DynamicResource Subtle2}" BorderThickness="1" BorderBrush="Transparent">
                                        <local:SvgIcon Kind="chevron-down" Width="12" Height="12" HorizontalAlignment="Right" Margin="0,0,11,0" Foreground="{DynamicResource Fg2}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CardHover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="Focus" CornerRadius="15" BorderThickness="1.5" BorderBrush="{DynamicResource Fg}" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="12,6,30,6" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.FontWeight="SemiBold" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <Border Margin="0,4,6,8" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4">
                                <ScrollViewer x:Name="DropDownScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" CornerRadius="8" Padding="10,5" Background="Transparent">
                        <ContentPresenter TextElement.FontSize="12" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Subtle2}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A thin scroll bar that fits the panel. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Width="4" HorizontalAlignment="Center" Background="{DynamicResource Fg3}" Opacity="0.5" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small coloured chip ("Monitor on", "always allow"...), like the +11% chips on a dashboard. -->
    <DataTemplate DataType="{x:Type core:Tag}">
        <Grid VerticalAlignment="Center" Margin="4,0,0,0">
            <Border x:Name="Bg" CornerRadius="9" Opacity="0.14" Background="{DynamicResource Gray}" />
            <TextBlock x:Name="Label" Text="{Binding Text}" Margin="8,2,8,3" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Gray}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Good">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Green}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Green}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Warn">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Orange}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Orange}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Bad">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Red}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Red}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Info">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Blue}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Blue}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <BooleanToVisibilityConverter x:Key="Visible" />
    <local:BoolToCollapsedConverter x:Key="Hidden" />
    <local:NullToCollapsedConverter x:Key="IfSet" />
</ResourceDictionary>
