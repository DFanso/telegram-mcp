<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows tray app: tgmcp menubar builds it with dotnet publish into tray/build. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- For NotifyIcon (WPF has no tray icon) and System.Drawing to draw it. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms share type names (Application, Button...): every file says what it uses. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 wants DPI awareness set through WinForms' API; this is a WPF app (WinForms only draws
         the tray icon), and WPF reads it from the manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>TelegramMCPTray</AssemblyName>
    <RootNamespace>TelegramMCPTray</RootNamespace>
    <!-- The name Windows shows on notifications and in Settings > Apps > Startup. -->
    <AssemblyTitle>Telegram MCP</AssemblyTitle>
    <Product>Telegram MCP</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <ProjectReference Include="../Core/TelegramMCPTray.Core.csproj" />
  </ItemGroup>
</Project>
